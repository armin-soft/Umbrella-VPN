#pragma code_page(65001)

// منابع فایل های اجرایی لانچر آمبرلا: آیکون و متن نسخه.
//
// همان آیکون خود برنامه است، پس در پنجره خط فرمان، در نوار وظیفه و در پنجره
// UAC لوگوی آمبرلا دیده می شود، نه لوگوی هیدیفای.
//
// مانیفست (درخواست دسترسی مدیر) با گزینه پیوند دهنده در windows/CMakeLists.txt
// اضافه می شود، نه اینجا؛ آن روش مطمئن تر است.

#include <winres.h>

// آیکون آمبرلا در همه فایل های اجرایی، با شناسه 1: ویندوز همین را در Explorer،
// نوار وظیفه و پنجره UAC نشان می دهد. مسیر نسبت به همین فایل است.
1 ICON "..\\windows\\runner\\resources\\app_icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION UMBRELLA_FILE_VERSION
 PRODUCTVERSION UMBRELLA_FILE_VERSION
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Umbrella"
            VALUE "FileDescription", UMBRELLA_FILE_DESCRIPTION
            VALUE "FileVersion", UMBRELLA_FILE_VERSION_TEXT
            VALUE "InternalName", UMBRELLA_INTERNAL_NAME
            VALUE "LegalCopyright", "Umbrella"
            VALUE "OriginalFilename", UMBRELLA_INTERNAL_NAME
            VALUE "ProductName", "فیلترشکن آمبرلا"
            VALUE "ProductVersion", UMBRELLA_FILE_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
